# Cloudinary — para subir fotos de proyectos (opcional)
# Crear cuenta gratuita en https://cloudinary.com
# Si no se configura, las fotos se guardan localmente en el volumen Docker.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secreto para el endpoint de subida de imágenes (requerido para usar la función de agregar proyecto)
# Generar con: openssl rand -hex 32
UPLOAD_SECRET=
